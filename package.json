{
  "name": "fsis-request",
  "version": "1.0.0",
  "scripts": {
    "server": "cd server && npm run dev",
    "client": "cd client && npm run dev",
    "install:all": "cd server && npm install && cd ../client && npm install",
    "migrate": "cd server && npm run migrate",
    "dev": "concurrently \"npm run server\" \"npm run client\""
  }
}
