# PostgreSQL Database
DB_USER=fsis
DB_PASSWORD=your_secure_password_here
DB_NAME=fsis

# JWT Secret (CHANGE THIS IN PRODUCTION)
JWT_SECRET=change_this_to_a_strong_secret_key_at_least_32_characters

# Application URLs
SERVER_PORT=3001
CLIENT_PORT=80
BASE_URL=http://localhost:3001

